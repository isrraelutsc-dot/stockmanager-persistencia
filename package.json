    "expo-font": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-sqlite": "~58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
